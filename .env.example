# GEMINI_API_KEY: Required for Gemini AI API calls (crop health analysis).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JWT tokens. Change in production!
JWT_SECRET="farmwise-change-this-in-production"

# OPENWEATHER_API_KEY: Optional. For real weather data from OpenWeatherMap.
# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# MONGODB_URI: Connection URI for MongoDB database
MONGODB_URI="mongodb://localhost:27017"

# MONGODB_DATABASE: Name of MongoDB database (must be FarmWise)
MONGODB_DATABASE="FarmWise"

# Standard SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SENDER_EMAIL="noreply@farmwise.com"

