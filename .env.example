# ============================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Local .env)
# ============================================================

# MongoDB Atlas Database Connection URI
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/FarmWise?retryWrites=true&w=majority"
MONGODB_DATABASE="FarmWise"

# Security & JWT Token Signing
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# Allowed Frontend URL for CORS (your Vercel app domain)
FRONTEND_URL="https://your-frontend.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app"

# AI Crop Diagnostics (Google Gemini Vision API Key)
GEMINI_API_KEY="your-gemini-api-key"

# Live Weather Forecast & Advisories (OpenWeatherMap API Key)
OPENWEATHER_API_KEY="your-openweather-api-key"

# Email / SMTP Settings for Registration OTPs
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-app-password"
SENDER_EMAIL="noreply@yourdomain.com"
BREVO_API_KEY=""

# ============================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ============================================================

# URL of the deployed FastAPI Backend on Render
VITE_API_URL="https://your-backend-api.onrender.com"
