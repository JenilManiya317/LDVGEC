# ==============================================================================
# AgriSetu — Git Ignore Rules
# ==============================================================================

# --- Node & Frontend Dependencies & Builds ---
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
.cache/
*.tsbuildinfo

# --- Python & ML Artifacts ---
__pycache__/
*/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.egg-info/
.installed.cfg
*.egg
catboost_info/

# --- Python Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# --- Databases & SQLite ---
*.db
*.sqlite
*.sqlite3

# --- Archives & Backups ---
*.zip
*.tar.gz
*.tgz
*.rar
*.bak

# --- Logs & Debugging ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Coverage ---
coverage/
.nyc_output/
*.lcov

# --- IDEs & Code Editors ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Local Agent & IDE Caches ---
.agents/
.gemini/